<?xml version="1.0"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- Inherit common configuration from parent -->
    <parent>
        <groupId>org.grnet</groupId>
        <artifactId>status</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>status-api</artifactId>
    <name>status-api</name>
    <version>${revision}</version>
    <dependencies>
        <!-- Quarkus core runtime -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest</artifactId>
        </dependency>

        <!-- REST & JSON support -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-client-jackson</artifactId>
        </dependency>

        <!-- Qute templates (HTML) -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-qute</artifactId>
        </dependency>

        <!-- OpenAPI & Swagger UI -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-openapi</artifactId>
        </dependency>

        <!-- Health checks -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-health</artifactId>
        </dependency>

        <!-- Internal modules -->
        <dependency>
            <groupId>org.grnet</groupId>
            <artifactId>status-mappers</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>org.grnet</groupId>
            <artifactId>status-repositories</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>org.grnet</groupId>
            <artifactId>status-entities</artifactId>
            <version>${revision}</version>
        </dependency>

        <dependency>
            <groupId>org.grnet</groupId>
            <artifactId>status-validators</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>org.grnet</groupId>
            <artifactId>status-data-transfer-objects</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>org.grnet</groupId>
            <artifactId>status-services</artifactId>
            <version>${revision}</version>
        </dependency>

        <dependency>
            <groupId>org.grnet</groupId>
            <artifactId>status-util</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>org.grnet</groupId>
            <artifactId>status-handlers</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>org.grnet</groupId>
            <artifactId>status-authorizations</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- Testing -->

        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-test-keycloak-server</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit5-mockito</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-validator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkiverse.mailpit</groupId>
            <artifactId>quarkus-mailpit</artifactId>
            <version>2.0.0</version>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-health</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Quarkus build -->
            <plugin>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
            </plugin>

            <!-- Jandex index (required for Quarkus reflection) -->
            <plugin>
                <groupId>io.smallrye</groupId>
                <artifactId>jandex-maven-plugin</artifactId>
            </plugin>

            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire-plugin.version}</version>
            </plugin>
        </plugins>
    </build>
</project>